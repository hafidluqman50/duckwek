PORT=8080
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=duckwek
PGUSER=postgres
PGPASSWORD=postgres

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Chain (Monad testnet = 10143, anvil = 31337). Use a dedicated endpoint (Alchemy), never the public RPC.
CHAIN_ID=10143
RPC_URL=
EXPLORER_URL=https://testnet.monadvision.com

# Operator = the relayer: pays gas, calls createRoom / joinBatch / start / tick / finalize / spend / withdrawWithSig. It cannot withdraw anyone's funds.
OPERATOR_PRIVATE_KEY=

# Contracts (output of smart-contract/script/Deploy.s.sol)
RACE=
VAULT=
DUCK_NFT=
MOCK_USDC=
BADGE=

# EIP-712 domain of the payment token (Mock USDC: "Mock USDC" / "1"; Circle USDC: "USD Coin" / "2")
USDC_NAME=Mock USDC
USDC_VERSION=1

# The one signature at connect: spending cap (6 decimals, 5 USDC) and lifetime in seconds
SESSION_CAP=5000000
SESSION_TTL_SEC=86400
# Minted by the Vault in a wallet's first paid order (equals MockUSDC.WELCOME_AMOUNT)
WELCOME_USDC=5000000

# Fixed gas limit of a tick: the highest tick gas measured on testnet plus 10 % (plan Q-11, test T-3). Monad charges the limit.
TICK_GAS=53100
TICK_INTERVAL_MS=300

# Join batching (DuckWekRace.MAX_BATCH = 100)
JOIN_BATCH_WINDOW_MS=400
JOIN_BATCH_MAX=100

# Race
FILL_BOTS=true
COUNTDOWN_SEC=3
