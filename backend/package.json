{
  "name": "duckwek-backend",
  "version": "1.0.0",
  "private": true,
  "description": "DuckWek API + realtime race server (Express, Sequelize, PostgreSQL, Socket.io)",
  "main": "dist/index.js",
  "scripts": {
    "compile": "tsc --watch",
    "build": "tsc && cp api-duckwek-docs.yaml dist/",
    "start": "node dist/index.js",
    "start:dev": "nodemon dist/index.js",
    "dev": "nodemon --watch . --ext ts --exec \"ts-node -r tsconfig-paths/register index.ts\"",
    "migrate:latest": "ts-node -r tsconfig-paths/register database/migrate.ts up",
    "migrate:down": "ts-node -r tsconfig-paths/register database/migrate.ts down",
    "seed:run": "ts-node -r tsconfig-paths/register database/seed.ts",
    "test:load": "ts-node -T test/load/loadtest.ts",
    "test:e2e": "ts-node -T test/e2e/flow.e2e.ts",
    "test:balance": "ts-node -T test/engine/search.script.ts \"[[[2,0,-1],[1,1,0],[-1,1,2]]]\""
  },
  "author": "Hafiidh Luqmanul Hakim",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2",
    "viem": "^2.21.54",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^20.17.10",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/yamljs": "^0.2.34",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}