# Deployer (owner). On mainnet this must be a multisig.
PRIVATE_KEY=0x...

RPC_URL=https://testnet-rpc.monad.xyz

# Roles
OPERATOR=0x...        # relayer: charges orders and submits race lifecycle calls
TREASURY=0x...        # protocol fee receiver (separate multisig on mainnet)

# Welcome USDC mint is an option, not a permanent rule. Enable it on testnet only.
# On mainnet keep it false: real USDC has no welcomeMint.
WELCOME_ENABLED=true

MOCK_USDC=
TRACK_NFT=
PART_NFT=
DUCK_NFT=
BADGE=
VAULT=
RACE=
